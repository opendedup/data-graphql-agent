# Google Cloud Project Configuration
# Your GCP project ID where BigQuery and other resources are located
GCP_PROJECT_ID=your-project-id-here

# GCP region/location for services (e.g., us-central1, us-east1, europe-west1)
GCP_LOCATION=us-central1

# GraphQL Server Output Configuration
# Output directory for generated GraphQL server code
# Can be a GCS path (gs://bucket/path) or local filesystem path (/path/to/output)
GRAPHQL_OUTPUT_DIR=gs://your-bucket-name/graphql-server

# MCP Server Transport Configuration
# Transport protocol: "stdio" for Cursor integration (default), "http" for remote/containerized deployments
MCP_TRANSPORT=stdio

# MCP HTTP Server Configuration (only used when MCP_TRANSPORT=http)
# Host to bind HTTP server to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
MCP_HOST=0.0.0.0

# Port for HTTP server to listen on
MCP_PORT=8080
