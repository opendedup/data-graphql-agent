# Google Cloud Project ID
GCP_PROJECT_ID=your-project-id-here

# Google Cloud Location
GCP_LOCATION=us-central1

# Output directory for generated GraphQL server code
# Code will be generated in: GRAPHQL_OUTPUT_DIR/<project_name>/graphql_<timestamp>/
# Project names are converted to lowercase for case-insensitive folder names
GRAPHQL_OUTPUT_DIR=./output

# MCP transport type (stdio or http)
MCP_TRANSPORT=stdio

# MCP HTTP server host (only used when MCP_TRANSPORT=http)
MCP_HOST=0.0.0.0

# MCP HTTP server port (only used when MCP_TRANSPORT=http)
MCP_PORT=8080

# Enable MCP authentication (only used when MCP_TRANSPORT=http)
MCP_AUTH_ENABLED=false
