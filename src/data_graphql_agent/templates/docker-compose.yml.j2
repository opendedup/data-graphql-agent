version: '3.8'

services:
  graphql-api:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "4000:4000"
    environment:
      - BIGQUERY_PROJECT_ID=${BIGQUERY_PROJECT_ID}
      - BIGQUERY_LOCATION=${BIGQUERY_LOCATION:-US}
      - DATAPLEX_PROJECT_ID=${DATAPLEX_PROJECT_ID}
      - DATAPLEX_LOCATION=${DATAPLEX_LOCATION:-us-central1}
      - PORT=4000
    volumes:
      - ./config:/app/config:ro
      - ~/.config/gcloud:/root/.config/gcloud:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:4000/.well-known/apollo/server-health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

