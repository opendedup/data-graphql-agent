import { LineageClient } from '@google-cloud/lineage';
import { google } from '@google-cloud/lineage/build/protos/protos';

const client = new LineageClient();

// Track all created lineage events for cleanup
const createdProcesses = new Set<string>();

interface LineageEventParams {
  processId: string;
  sources: string[];
  target: string;
  sql: string;
  requestId?: string;
}

/**
 * Initialize lineage tracking on server startup
 */
export async function initializeLineage(): Promise<void> {
  console.log('Initializing Dataplex lineage tracking...');
  const project = process.env.DATAPLEX_PROJECT_ID;
  const location = process.env.DATAPLEX_LOCATION || 'us-central1';
  
  if (!project) {
    console.warn('DATAPLEX_PROJECT_ID not set, lineage tracking disabled');
    return;
  }

  console.log(`Lineage tracking enabled for project: ${project}, location: ${location}`);
}

/**
 * Create a lineage event linking BigQuery sources to BI report target.
 * 
 * @param params - Lineage event parameters including request ID for tracing
 */
export async function createLineageEvent(params: LineageEventParams): Promise<void> {
  const { requestId = 'unknown' } = params;
  const project = process.env.DATAPLEX_PROJECT_ID;
  const location = process.env.DATAPLEX_LOCATION || 'us-central1';

  if (!project) {
    console.warn(`[${requestId}] Lineage tracking disabled - DATAPLEX_PROJECT_ID not set`);
    return;
  }

  try {
    const parent = `projects/${project}/locations/${location}`;
    const processName = `${parent}/processes/${params.processId}`;
    const runId = `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    const runName = `${processName}/runs/${runId}`;

    // Create or update Process entity
    if (!createdProcesses.has(params.processId)) {
      try {
        await client.createProcess({
          parent: parent,
          process: {
            name: processName,
            displayName: params.processId,
            attributes: {
              'query_type': 'graphql_resolver',
              'sql': params.sql,
            },
          },
          requestId: `${params.processId}-${Date.now()}`,
        });
        createdProcesses.add(params.processId);
        console.log(`[${requestId}] Created lineage process: ${params.processId}`);
      } catch (error: any) {
        // Process might already exist
        if (!error.message?.includes('ALREADY_EXISTS')) {
          console.error(`[${requestId}] Error creating process ${params.processId}:`, error);
        } else {
          createdProcesses.add(params.processId);
        }
      }
    }

    // Create Run entity
    await client.createRun({
      parent: processName,
      run: {
        name: runName,
        displayName: `Run ${runId}`,
        state: google.cloud.datacatalog.lineage.v1.Run.State.COMPLETED,
        startTime: {
          seconds: Math.floor(Date.now() / 1000),
          nanos: 0,
        },
        endTime: {
          seconds: Math.floor(Date.now() / 1000),
          nanos: 0,
        },
      },
      requestId: `${runId}-run`,
    });

    // Create LineageEvent linking sources to target
    const links: google.cloud.datacatalog.lineage.v1.IEventLink[] = [];

    // Add source links (BigQuery tables)
    for (const sourceTable of params.sources) {
      links.push({
        source: {
          fullyQualifiedName: `bigquery:${sourceTable}`,
        },
        target: {
          fullyQualifiedName: params.target,
        },
      });
    }

    await client.createLineageEvent({
      parent: runName,
      lineageEvent: {
        links: links,
        startTime: {
          seconds: Math.floor(Date.now() / 1000),
          nanos: 0,
        },
      },
      requestId: `${runId}-event`,
    });

    console.log(`[${requestId}] Created lineage event for ${params.processId}`);
  } catch (error) {
    console.error(`[${requestId}] Failed to create lineage event for ${params.processId}:`, error);
    throw error;
  }
}

/**
 * Clean up lineage events on server shutdown
 */
export async function cleanupLineage(): Promise<void> {
  const project = process.env.DATAPLEX_PROJECT_ID;
  const location = process.env.DATAPLEX_LOCATION || 'us-central1';

  if (!project || createdProcesses.size === 0) {
    return;
  }

  console.log(`Cleaning up ${createdProcesses.size} lineage processes...`);

  const parent = `projects/${project}/locations/${location}`;

  for (const processId of createdProcesses) {
    try {
      const processName = `${parent}/processes/${processId}`;
      await client.deleteProcess({ name: processName });
      console.log(`Deleted lineage process: ${processId}`);
    } catch (error) {
      console.error(`Failed to delete lineage process ${processId}:`, error);
    }
  }

  createdProcesses.clear();
}

