import { GraphQLError, GraphQLResolveInfo } from 'graphql';
import { GraphQLContext } from './context';
import { DateTimeScalar } from './scalars';
import { buildQueryFromGraphQL } from './query-builder';

/**
 * GraphQL resolvers for {{ project_name }}.
 * Auto-generated with dynamic query building using Kysely + BigQuery.
 */
export const resolvers = {
  // Custom scalar resolvers
  DateTime: DateTimeScalar,

  Query: {
{% for query in queries %}
    /**
     * Resolver for {{ query.queryName }}.
     * 
     * BigQuery View: {{ query.view_id }}
     * Source tables: {{ query.source_tables | join(', ') }}
     {% if query.description %}* Description: {{ query.description }}{% endif %}
     */
    {{ query.queryName }}: async (
      _parent: unknown,
      args: Record<string, any>,
      context: GraphQLContext,
      info: GraphQLResolveInfo
    ): Promise<any[]> => {
      const { bigquery, kysely, requestId } = context;
      
      try {
        console.log(`[${requestId}] Executing: {{ query.queryName }}`);
        
        // Build dynamic SQL from GraphQL query using Kysely
        const { sql, parameters } = buildQueryFromGraphQL(
          kysely,
          '{{ query.view_id }}',
          info,
          args
        );

        console.log(`[${requestId}] Generated SQL:`, sql);
        console.log(`[${requestId}] Parameters:`, parameters);
        
        // Execute BigQuery query with parameters
        const [rows] = await bigquery.query({
          query: sql,
          params: parameters,
          location: process.env.BIGQUERY_LOCATION || 'US',
        });

        console.log(`[${requestId}] Returned ${rows.length} rows from {{ query.queryName }}`);
        
        return rows;
      } catch (error) {
        console.error(`[${requestId}] Query error in {{ query.queryName }}:`, error);
        
        throw new GraphQLError('Failed to execute BigQuery query', {
          extensions: {
            code: 'BIGQUERY_ERROR',
            queryName: '{{ query.queryName }}',
            viewId: '{{ query.view_id }}',
            originalError: error instanceof Error ? error.message : String(error),
            requestId: requestId,
          },
        });
      }
    },
{% endfor %}
  },
};

