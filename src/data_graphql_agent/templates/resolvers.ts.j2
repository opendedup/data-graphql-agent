import { GraphQLError } from 'graphql';
import { GraphQLContext } from './context';
import { createLineageEvent } from './lineage';

/**
 * GraphQL resolvers for {{ project_name }}.
 * Auto-generated from BigQuery queries with type-safe context.
 */
export const resolvers = {
  Query: {
{% for query in queries %}
    /**
     * Resolver for {{ query.queryName }}.
     * 
     * Executes BigQuery query and tracks lineage.
     * Source tables: {{ query.source_tables | join(', ') }}
     */
    {{ query.queryName }}: async (
      _parent: unknown,
      _args: Record<string, never>, // Update with actual args type if needed
      context: GraphQLContext
    ): Promise<any[]> => {
      const { bigquery, requestId } = context;
      const sql = `{{ query.sql }}`;
      
      try {
        console.log(`[${requestId}] Executing: {{ query.queryName }}`);
        
        // Execute BigQuery query
        const [rows] = await bigquery.query({
          query: sql,
          location: process.env.BIGQUERY_LOCATION || 'US',
        });

        // Fire-and-forget lineage reporting (async, non-blocking)
        createLineageEvent({
          processId: 'resolver:{{ query.queryName }}',
          sources: {{ query.source_tables | tojson }},
          target: `custom:bi-report:{{ project_name }}.{{ query.queryName }}`,
          sql: sql,
          requestId: requestId,
        }).catch((error) => {
          console.error(`[${requestId}] Lineage error:`, error);
        });

        console.log(`[${requestId}] Returned ${rows.length} rows from {{ query.queryName }}`);
        return rows;
      } catch (error) {
        console.error(`[${requestId}] Query error in {{ query.queryName }}:`, error);
        
        // Throw GraphQLError with proper error code and extensions
        throw new GraphQLError('Failed to execute BigQuery query', {
          extensions: {
            code: 'BIGQUERY_ERROR',
            queryName: '{{ query.queryName }}',
            originalError: error instanceof Error ? error.message : String(error),
            requestId: requestId,
          },
        });
      }
    },
{% endfor %}
  },
};

